{
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
        "MinimumLevel": {
            // 1. Silence all external libraries (System, Microsoft, etc.) by default
            "Default": "Warning",
            "Override": {
                // 2. Enable YOUR logs (Everything inside your DientesLimpios namespace)
                "DientesLimpios": "Information",

                // 3. Force silence on specific noisy libraries (Lucky Penny warnings)
                "LuckyPennySoftware": "Error",

                // (Optional) Ensure ASP.NET core internal warnings don't clutter the log
                "Microsoft": "Warning",
                "System": "Warning"
            }
        },
        "WriteTo": [
            { "Name": "Console" },
            {
                "Name": "File",
                "Args": {
                    "path": "C:\\Logs\\DientesLimpios\\Log-.txt",
                    "rollingInterval": "Day",
                    // 4. Clean, short text format instead of JSON
                    "outputTemplate": "{Timestamp:HH:mm:ss} | {Level:u3} | {Message:lj}{NewLine}{Exception}"
                }
            }
        ],
        "Enrich": [ "FromLogContext" ]
    },

    "AllowedHosts": "*",
    "Email": {
        "Host": "smtp.gmail.com",
        "Port": 587,
        "Email": "xxx",
        "Password": "xxx"
    }
}
