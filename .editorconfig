root = true
 
[*.cs]
# These analyzer rules fire frequently with low signal in a typical .NET 10 codebase.
# Keep them visible as suggestions, but don't fail the build on them.
 
dotnet_diagnostic.CA1062.severity = suggestion   # Validate arguments of public methods (noisy for DTOs / handlers)
dotnet_diagnostic.CA1812.severity = suggestion   # Avoid uninstantiated internal classes (fires on EF Core entities, FluentValidation validators discovered by reflection)
dotnet_diagnostic.CA1515.severity = suggestion   # Types can be made internal (would force a wide review of public API)
dotnet_diagnostic.CA1707.severity = suggestion   # Identifiers should not contain underscores
dotnet_diagnostic.CS1591.severity = none         # Missing XML doc comment (only meaningful for public NuGet packages)
dotnet_diagnostic.CA1002.severity = suggestion   # Do not expose generic List<T> (your DTOs intentionally do)
dotnet_diagnostic.CA2227.severity = suggestion   # Collection properties should be read only (same reason — DTOs)
dotnet_diagnostic.CA1716.severity = none		 # Reserved keywords in other languages — not relevant for an internal C#-only solution
dotnet_diagnostic.CA2225.severity = none		 # Operator named alternates — implicit conversions are intentional for Result pattern ergonomics
dotnet_diagnostic.CA1008.severity = none		 # Enum default-initialization is prevented by factory-based entity construction (Cita.Crear, Paciente.Crear, etc.)
dotnet_diagnostic.CA1034.severity = none		 # Nested static classes in DomainErrors are an intentional grouping mechanism for the Result pattern (DomainErrors.Appointment.Overlapping reads as a sentence).
dotnet_diagnostic.CA1848.severity = suggestion   # Use LoggerMessage delegates — performance micro-optimization
dotnet_diagnostic.CA1873.severity = suggestion   # Possibly-expensive arg in log call — handled by log level filters
dotnet_diagnostic.CA2007.severity = none         # ConfigureAwait in ASP.NET Core apps — no SynchronizationContext
dotnet_diagnostic.CA1032.severity = suggestion   # Standard exception constructors — intentionally limited
dotnet_diagnostic.CA1040.severity = none         # Empty marker interfaces (IRequest) are intentional for the mediator pattern
dotnet_diagnostic.CA1819.severity = suggestion   # Properties should not return arrays — used in ValidationError DTO
dotnet_diagnostic.CA1031.severity = suggestion   # Catch general Exception — broad catch in command handlers is intentional
dotnet_diagnostic.CA2000.severity = suggestion   # Dispose objects before losing scope — SmtpClient/MailMessage in EmailService
dotnet_diagnostic.CA1305.severity = suggestion   # Specify IFormatProvider — pre-existing in pagination helpers and logging setup
dotnet_diagnostic.CA1724.severity = suggestion   # Type name conflicts with namespace — ArchitectureTests test class
dotnet_diagnostic.CA2016.severity = suggestion   # Forward CancellationToken — AppointmentReminderJob
dotnet_diagnostic.CA1859.severity = suggestion   # Use concrete return type for performance — ResultExtensions

 
# Test code — relax further
[**/*Tests/**.cs]
dotnet_diagnostic.CA1707.severity = none         # Underscore-separated test method names are conventional
dotnet_diagnostic.CA1822.severity = none         # Mark members as static (per-test arrange methods)
dotnet_diagnostic.CA2007.severity = none         # ConfigureAwait (not relevant in test code)
dotnet_diagnostic.CA1515.severity = none         # Tests are intentionally public
